# /etc/medsync/env — переменные сервера MedSync в рабочей среде. Права 600. НЕ коммитить заполненный файл.
NODE_ENV=production
PUBLIC_ORIGIN=https://medsync.example.kg
DATA_KEYS=k1:...            # npm run db:setup; копию хранить отдельно от копий базы
DATABASE_URL=postgres://medsync@127.0.0.1/medsync?sslmode=verify-full
ASR_URL=https://10.0.0.5:8080/inference   # только внутренний адрес; наружу не открывать
ANTHROPIC_API_KEY=...       # только после юридического разрешения (вопрос 30 и др.)
SIGNING_DEMO_KEY=...
AUDIT_RETENTION_YEARS=5
# Тревоги людям (хотя бы одно):
ALERT_WEBHOOK_URL=https://hooks.example/...
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
