# Обратный прокси MedSync (шаг 3.7). Caddy 2.8 или новее; сам получает и продлевает сертификат Let's Encrypt.
# ВНИМАНИЕ: файл не проверен запуском (Caddy в среде разработки не установлен). Перед включением: caddy validate --config deploy/Caddyfile
# Подстановка: MEDSYNC_DOMAIN=medsync.example.kg (переменная окружения службы caddy).
# Схема: интернет → Caddy :443 → статические файлы приложения (dist) и /api → Node на 127.0.0.1:8787.
# Сервис распознавания речи сюда НЕ выводится: он слушает только внутренний адрес и доступен лишь серверу MedSync.
{
	# Не сообщаем версию сервера; админ-интерфейс Caddy только локально.
	admin localhost:2019
	servers {
		timeouts {
			read_header 10s
			idle 60s
		}
		max_header_size 16KB
	}
}

{$MEDSYNC_DOMAIN} {
	# Только TLS 1.2 и 1.3 (Caddy по умолчанию так и делает; указано явно для проверки сканером).
	tls {
		protocols tls1.2 tls1.3
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Строгая политика: только скрипты, стили и картинки с этого же сайта, без встроенных скриптов и стилей.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Микрофон — только этому сайту; камера, геолокация и прочее не нужны.
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-Via
	}

	# API: тело запроса ограничено (самый большой — сегмент речи 30 с, около 1 МБ).
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8787 {
			# Node берёт адрес клиента из последнего X-Forwarded-For (server/net.ts); Caddy дописывает настоящий адрес.
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 130s
			}
		}
	}

	# Служебные файлы и скрытые пути не отдаются.
	@hidden path /.* /*.map
	respond @hidden 404

	handle {
		root * /srv/medsync/dist
		# Файлы со «отпечатком» в имени можно кэшировать надолго; index.html, sw.js и manifest — нет.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Страница приложения — no-store: после выхода «Назад» и «Вперёд» не должны показывать старый экран с данными.
		@shell path / /index.html
		header @shell Cache-Control "no-store"
		@fresh path /sw.js /manifest.webmanifest /offline.html /offline.css
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/medsync-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		# В журнал прокси не пишем cookie и заголовок авторизации.
		format filter {
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}

# http → https (Caddy делает это сам; блок для ясности).
http://{$MEDSYNC_DOMAIN} {
	redir https://{host}{uri} permanent
}
