# ���������� � .env � �������� ���� ����. ���� .env �� ����������.
ANTHROPIC_API_KEY=

# Распознавание речи на этом же компьютере (см. docs/ASR_DESIGN.md). Адрес не из локальной сети сервер не примет.
ASR_URL=
# ASR_ENGINE=mock   # заглушка для проверки микрофона без модели
# ASR_CONFIDENCE=0   # без уверенности по словам: примерно вдвое быстрее на слабом процессоре

# Адреса обёрнутых мобильных приложений (через запятую). Им разрешены CORS и вход по токену; браузеру токены не выдаются.
# APP_ORIGINS=capacitor://localhost,https://localhost

# База данных (шаг 3.2, docs/DB_OPERATIONS.md). Ключ шифрования данных создаётся командой npm run db:setup и НЕ хранится с копиями базы.
# DATA_KEYS=k1:...
# DATABASE_URL=postgres://...?sslmode=verify-full   # сервер PostgreSQL; без него используется встроенная база в data/db
# DB_DIR=data/db
# AUDIT_RETENTION_YEARS=5   # srok hraneniya zhurnala audita dlya otchyota (npm run audit:status); predvaritelno, opredelit yurist

# Internet deployment (step 3.7, docs/DEPLOY.md). Server listens on 127.0.0.1 behind the reverse proxy.
# PUBLIC_ORIGIN=https://medsync.example.kg   # enables HSTS, __Host- cookie, trusted proxy address
# TRUST_PROXY=1                             # only if a proxy runs on this machine without PUBLIC_ORIGIN
# ALERT_WEBHOOK_URL=https://...              # alerts as {"text": "..."}
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
