{
  "name": "medsync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:lan": "tsx scripts/dev-lan.ts",
    "dev:lan:app": "tsx scripts/dev-lan.ts --build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsx src/data/pin.test.ts && tsx server/extract.test.ts && tsx server/guards.test.ts && tsx src/domain/rules.test.ts && tsx server/eval/check.test.ts && tsx server/audit.test.ts && tsx server/rbac.test.ts && tsx server/auth.test.ts && tsx server/app.test.ts && tsx server/app.test.ts --pglite && tsx server/db/db.test.ts && tsx server/asr/engine.test.ts && tsx server/asr/metrics.test.ts && tsx src/audio/segmenter.test.ts && tsx src/audio/suggest.test.ts && tsx src/audio/resample.test.ts && tsx scripts/lan.test.ts && tsx scripts/pwa.test.ts && tsx scripts/bundle.test.ts",
    "server": "tsx --env-file=.env server/index.ts",
    "db:setup": "tsx scripts/db.ts setup",
    "db:status": "tsx --env-file-if-exists=.env scripts/db.ts status",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db.ts backup",
    "db:restore": "tsx --env-file-if-exists=.env scripts/db.ts restore",
    "db:drill": "tsx --env-file-if-exists=.env scripts/db.ts drill",
    "scan": "tsx scripts/scan.ts",
    "eval": "tsx --env-file=.env server/eval/run.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "asr:eval": "tsx scripts/asr-eval.ts",
    "asr:smoke": "tsx scripts/asr-smoke.ts",
    "asr:flags": "tsx scripts/asr-flag-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@electric-sql/pglite": "^0.6.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
