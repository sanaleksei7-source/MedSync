{
  "name": "medsync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsx src/data/pin.test.ts && tsx server/extract.test.ts && tsx server/guards.test.ts && tsx src/domain/rules.test.ts && tsx server/eval/check.test.ts",
    "server": "tsx --env-file=.env server/index.ts",
    "scan": "tsx scripts/scan.ts",
    "eval": "tsx --env-file=.env server/eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}